{
  "name": "gigboy",
  "compatibility_date": "2026-04-25",
  "pages_build_output_dir": "./dist",
  "env": {
    "production": {
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiterDO",
            "script_name": "gigboy-rate-limiter"
          }
        ]
      },
      // This file is tracked in git and is a template: it intentionally contains no
      // real project IDs or Stripe price IDs. Production (Cloudflare Pages) supplies all
      // of these as dashboard environment variables for the production environment
      // (both plain and VITE_-prefixed copies) — confirmed working 2026-08-18, dashboard
      // vars take precedence over these placeholders for Pages deployments.
      "vars": {
        "FIREBASE_PROJECT_ID": "your-firebase-project-id",
        // Secrets managed via Cloudflare dashboard / wrangler pages secret put:
        // FIREBASE_PRIVATE_KEY, FIREBASE_CLIENT_EMAIL,
        // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
        "STRIPE_PRO_MONTHLY_PRICE_ID": "price_replace_me_pro_monthly",
        "STRIPE_PRO_ANNUAL_PRICE_ID": "price_replace_me_pro_annual",
        "STRIPE_CREW_MONTHLY_PRICE_ID": "price_replace_me_crew_monthly",
        "STRIPE_CREW_ANNUAL_PRICE_ID": "price_replace_me_crew_annual",
        "STRIPE_CREW_MONTHLY_EXTRA_MEMBER_PRICE_ID": "price_replace_me_crew_monthly_extra_member",
        "STRIPE_CREW_ANNUAL_EXTRA_MEMBER_PRICE_ID": "price_replace_me_crew_annual_extra_member",
        "ADMIN_UIDS": "",
        // Client-side (Vite build-time) copies, exposed to the browser bundle:
        "VITE_STRIPE_PRO_MONTHLY_PRICE_ID": "price_replace_me_pro_monthly",
        "VITE_STRIPE_PRO_ANNUAL_PRICE_ID": "price_replace_me_pro_annual",
        "VITE_STRIPE_CREW_MONTHLY_PRICE_ID": "price_replace_me_crew_monthly",
        "VITE_STRIPE_CREW_ANNUAL_PRICE_ID": "price_replace_me_crew_annual",
        "VITE_STRIPE_CREW_MONTHLY_EXTRA_MEMBER_PRICE_ID": "price_replace_me_crew_monthly_extra_member",
        "VITE_STRIPE_CREW_ANNUAL_EXTRA_MEMBER_PRICE_ID": "price_replace_me_crew_annual_extra_member"
      }
    }
  }
}
