rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Anonymous (demo) users have a real uid but no email or persistent profile.
    function isAnonymousUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Prevent clients from writing elevated plan/billing fields on create.
    function subscriptionFieldsNotElevated() {
      let incoming = request.resource.data;
      return incoming.get('planOverride', false) == false
        && incoming.get('plan', 'free') == 'free'
        && incoming.get('subscriptionStatus', null) == null;
    }

    function isOwnerForResource(ownerId) {
      return isSignedIn() && ownerId == request.auth.uid;
    }

    function isCollaboratorOnResource() {
      return isSignedIn()
        && resource.data.collaboratorIds is list
        && resource.data.collaboratorIds.hasAny([request.auth.uid]);
    }

    function isEditorOnResource() {
      return isCollaboratorOnResource()
        && resource.data.collaborationPermissions[request.auth.uid] == 'editor';
    }

    function collaborationMetadataUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.collaboratorIds == resource.data.collaboratorIds
        && request.resource.data.collaborationPermissions == resource.data.collaborationPermissions;
    }

    function canReadResource(ownerId) {
      return isOwnerForResource(ownerId) || isCollaboratorOnResource();
    }

    function canUpdateResource(ownerId) {
      return isOwnerForResource(ownerId)
        || (isEditorOnResource() && collaborationMetadataUnchanged());
    }

    function bandDocument(bandId) {
      return get(/databases/$(database)/documents/bands/$(bandId));
    }

    function userSongDocument(ownerId, songId) {
      return get(/databases/$(database)/documents/users/$(ownerId)/songs/$(songId));
    }

    function userSongReadableByCurrentUser(ownerId, songId) {
      return isOwner(ownerId)
        || (
          isSignedIn()
          && userSongDocument(ownerId, songId).data.collaboratorIds is list
          && userSongDocument(ownerId, songId).data.collaboratorIds.hasAny([request.auth.uid])
        );
    }

    function isBandMember(bandId) {
      return isSignedIn()
        && bandDocument(bandId).data.memberIds is list
        && bandDocument(bandId).data.memberIds.hasAny([request.auth.uid]);
    }

    function isBandEditor(bandId) {
      return isBandMember(bandId)
        && (
          bandDocument(bandId).data.ownerId == request.auth.uid
          || bandDocument(bandId).data.memberRoles[request.auth.uid] == 'editor'
        );
    }

    function bandMembershipMetadataUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.memberRoles == resource.data.memberRoles
        && request.resource.data.memberUsernames == resource.data.memberUsernames
        && request.resource.data.memberEmails == resource.data.memberEmails
        && request.resource.data.memberAvatars == resource.data.memberAvatars;
    }

    // Ensures clients cannot elevate their own plan, override subscription status,
    // or tamper with Stripe billing fields. These fields are only written by
    // server-side Cloudflare Functions (webhook, override-plan) via the Admin SDK.
    function subscriptionFieldsUnchanged() {
      let incoming = request.resource.data;
      let existing = resource.data;
      return (!('plan' in incoming) || incoming.plan == existing.get('plan', 'free'))
        && (!('planOverride' in incoming) || incoming.planOverride == existing.get('planOverride', false))
        && (!('subscriptionStatus' in incoming) || incoming.subscriptionStatus == existing.get('subscriptionStatus', null))
        && (!('currentPeriodEnd' in incoming) || incoming.currentPeriodEnd == existing.get('currentPeriodEnd', null))
        && (!('stripeCustomerId' in incoming) || incoming.stripeCustomerId == existing.get('stripeCustomerId', null))
        && (!('storageQuotaBytes' in incoming) || incoming.storageQuotaBytes == existing.get('storageQuotaBytes', null));
    }

    // User-scoped songbook data
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && !isAnonymousUser()
        && subscriptionFieldsNotElevated();
      allow update: if isOwner(userId)
        && (
          // Username fields must not change here — they're managed via the usernames collection transaction
          (!('username' in request.resource.data) && !('usernameLower' in request.resource.data))
          || (request.resource.data.username == resource.data.username
              && request.resource.data.usernameLower == resource.data.usernameLower)
          // Allow setting username on first claim (no existing username)
          || (!('username' in resource.data) || resource.data.username == null)
        )
        // Clients must never write plan/billing fields — only server-side Admin SDK may do so
        && subscriptionFieldsUnchanged();
      allow delete: if isOwner(userId);

      match /songListCategories/{categoryId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /songLists/{songListId} {
        allow read: if isOwner(userId) || isCollaboratorOnResource();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId)
          || (isEditorOnResource() && collaborationMetadataUnchanged());
        allow delete: if isOwner(userId);
      }

      match /setlists/{setlistId} {
        allow read: if isOwner(userId) || isCollaboratorOnResource();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId)
          || (isEditorOnResource() && collaborationMetadataUnchanged());
        allow delete: if isOwner(userId);
      }

      match /songs/{songId} {
        allow read: if isOwner(userId) || isCollaboratorOnResource();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId)
          || (isEditorOnResource() && collaborationMetadataUnchanged());
        allow delete: if isOwner(userId);

        match /handNotes/{authorUid} {
          allow read: if userSongReadableByCurrentUser(userId, songId);
          allow create: if userSongReadableByCurrentUser(userId, songId)
            && authorUid == request.auth.uid
            && request.resource.data.authorUid == request.auth.uid;
          allow update: if userSongReadableByCurrentUser(userId, songId)
            && authorUid == request.auth.uid
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid;
          allow delete: if userSongReadableByCurrentUser(userId, songId)
            && authorUid == request.auth.uid
            && resource.data.authorUid == request.auth.uid;
        }
      }

      match /stageplots/{stageplotId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.ownerId == request.auth.uid);
        allow create: if isOwner(userId)
          || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
        allow update: if isOwner(userId)
          || (
            isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          );
        allow delete: if isOwner(userId)
          || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      }

      match /technicalRiders/{riderId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.ownerId == request.auth.uid);
        allow create: if isOwner(userId)
          || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
        allow update: if isOwner(userId)
          || (
            isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          );
        allow delete: if isOwner(userId)
          || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      }

      match /trashItems/{trashId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Owner fallback for user-scoped nested data that is not explicitly shared.
      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /usernames/{usernameLower} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !isAnonymousUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && !exists(/databases/$(database)/documents/usernames/$(usernameLower));
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.usernameLower == usernameLower;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /collaborationInvites/{inviteId} {
      function collaborationInviteEmailMatchesRecipient() {
        return request.auth.token.email is string
          && resource.data.recipientEmailLower is string
          && resource.data.recipientEmailLower == request.auth.token.email.lower();
      }

      function collaborationInviteBelongsToCurrentUser() {
        return resource.data.recipientUid == request.auth.uid
          || collaborationInviteEmailMatchesRecipient();
      }

      function collaborationInviteImmutableFieldsUnchanged() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.recipientEmail == resource.data.recipientEmail
          && request.resource.data.recipientEmailLower == resource.data.recipientEmailLower
          && request.resource.data.resourceType == resource.data.resourceType
          && request.resource.data.resourceId == resource.data.resourceId
          && request.resource.data.resourceName == resource.data.resourceName
          && request.resource.data.permission == resource.data.permission
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
        || collaborationInviteEmailMatchesRecipient()
      );

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && collaborationInviteBelongsToCurrentUser()
        && resource.data.status == 'pending'
        && collaborationInviteImmutableFieldsUnchanged()
        && request.resource.data.recipientUid == request.auth.uid
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')
        && request.resource.data.respondedAt is string;

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /bands/{bandId} {
      allow read: if isSignedIn() && isBandMember(bandId);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || (isBandEditor(bandId) && bandMembershipMetadataUnchanged())
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /songs/{songId} {
        allow read: if isBandMember(bandId);
        allow create, update, delete: if isBandEditor(bandId);

        match /handNotes/{authorUid} {
          allow read: if isBandMember(bandId);
          allow create: if isBandMember(bandId)
            && authorUid == request.auth.uid
            && request.resource.data.authorUid == request.auth.uid;
          allow update: if isBandMember(bandId)
            && authorUid == request.auth.uid
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid;
          allow delete: if isBandMember(bandId)
            && authorUid == request.auth.uid
            && resource.data.authorUid == request.auth.uid;
        }

        match /recordings/{recordingId} {
          allow read: if isBandMember(bandId);
          // Field-only rule for collection group queries (get() not allowed in that context)
          allow read: if request.auth != null && resource.data.recorder.userId == request.auth.uid;
          allow create: if isBandMember(bandId)
            && request.resource.data.recorder.userId == request.auth.uid;
          allow update: if isBandMember(bandId)
            && resource.data.recorder.userId == request.auth.uid
            && request.resource.data.recorder.userId == resource.data.recorder.userId;
          allow delete: if isBandMember(bandId)
            && resource.data.recorder.userId == request.auth.uid;
        }
      }

      match /songLists/{songListId} {
        allow read: if isBandMember(bandId);
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /setlists/{setlistId} {
        allow read: if isBandMember(bandId)
          || resource.data.publicShareEnabled == true;
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /stageplots/{stageplotId} {
        allow read: if isBandMember(bandId)
          || resource.data.publicShareEnabled == true;
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /technicalRiders/{riderId} {
        allow read: if isBandMember(bandId)
          || resource.data.publicShareEnabled == true;
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /pressKitTexts/{textId} {
        allow read: if isBandEditor(bandId);
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /pressKits/{kitId} {
        allow read: if isBandMember(bandId);
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /pressKitImages/{imageId} {
        allow read: if isBandMember(bandId);
        // Field-only rule for collection group queries (get() not allowed in that context)
        allow read: if request.auth != null && resource.data.createdBy == request.auth.uid;
        allow create, update, delete: if isBandEditor(bandId);
      }

      match /trashItems/{trashId} {
        allow read: if isBandMember(bandId);
        allow create, update, delete: if isBandEditor(bandId);
      }
    }

    match /bandInvites/{inviteId} {
      function bandInviteEmailMatchesRecipient() {
        return request.auth.token.email is string
          && resource.data.recipientEmailLower is string
          && resource.data.recipientEmailLower == request.auth.token.email.lower();
      }

      function bandInviteBelongsToCurrentUser() {
        return resource.data.recipientUid == request.auth.uid
          || bandInviteEmailMatchesRecipient();
      }

      function bandInviteImmutableFieldsUnchanged() {
        return request.resource.data.bandId == resource.data.bandId
          && request.resource.data.bandName == resource.data.bandName
          && request.resource.data.inviterId == resource.data.inviterId
          && request.resource.data.inviterEmail == resource.data.inviterEmail
          && request.resource.data.recipientUsername == resource.data.recipientUsername
          && request.resource.data.recipientUsernameLower == resource.data.recipientUsernameLower
          && request.resource.data.recipientEmail == resource.data.recipientEmail
          && request.resource.data.recipientEmailLower == resource.data.recipientEmailLower
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isSignedIn() && (
        resource.data.inviterId == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
        || bandInviteEmailMatchesRecipient()
      );

      allow create: if isSignedIn()
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && bandInviteBelongsToCurrentUser()
        && resource.data.status == 'pending'
        && bandInviteImmutableFieldsUnchanged()
        && request.resource.data.recipientUid == request.auth.uid
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')
        && request.resource.data.respondedAt is string;

      allow delete: if isSignedIn() && resource.data.inviterId == request.auth.uid;
    }

  }
}
