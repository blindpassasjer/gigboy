# Self-host configuration for Gigboy (Docker Compose deployment).
# Copy this file to .env.selfhost and fill in real values. .env.selfhost is gitignored —
# never commit it.

# Postgres password used by both the `postgres` service and DATABASE_URL below — keep them in sync.
POSTGRES_PASSWORD=change-me

# Connection string the app server uses to reach Postgres. Required, no fallback — the app
# fails fast at startup if this is unset. When running via docker-compose, "postgres" is the
# service hostname; the password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://gigboy:change-me@postgres:5432/gigboy

# Secret used to sign session cookies. Required, no fallback. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Port the app server listens on inside the container.
PORT=3000

# Whether session cookies get the `Secure` flag (only sent over HTTPS). Leave unset/false if
# you're accessing Gigboy directly over http:// (e.g. http://<nas-ip>:3000) — a Secure cookie
# would be silently dropped by the browser and login would appear to work but every API call
# would 401. Set to "true" only once a reverse proxy in front of the container terminates HTTPS.
COOKIE_SECURE=false
