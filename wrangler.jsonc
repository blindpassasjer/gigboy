{
  "name": "folio",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "development": {
      "vars": {
        "FIREBASE_PROJECT_ID": "",
        "FIREBASE_PRIVATE_KEY": "",
        "FIREBASE_CLIENT_EMAIL": "",
        "APP_URL": "http://localhost:5173",
        "RESEND_FROM_EMAIL": ""
      }
    },
    "production": {
      "vars": {
        "FIREBASE_PROJECT_ID": "",
        "FIREBASE_PRIVATE_KEY": "",
        "FIREBASE_CLIENT_EMAIL": "",
        "APP_URL": "",
        "RESEND_FROM_EMAIL": ""
      }
    }
  }
}
