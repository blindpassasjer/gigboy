rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anonymous sign-in is not offered by the app; reject it outright so a client
    // calling the Firebase Auth SDK directly can't mint throwaway demo accounts.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function bandDocument(bandId) {
      return firestore.get(/databases/(default)/documents/bands/$(bandId));
    }

    function isBandMember(bandId) {
      let band = bandDocument(bandId).data;
      return isSignedIn()
        && (
          (band.ownerId is string && band.ownerId == request.auth.uid)
          || (band.memberIds is list && band.memberIds.hasAny([request.auth.uid]))
          || (band.memberRoles is map && (band.memberRoles[request.auth.uid] == 'viewer' || band.memberRoles[request.auth.uid] == 'editor'))
        );
    }

    function isBandEditor(bandId) {
      let band = bandDocument(bandId).data;
      return isSignedIn()
        && (
          (band.ownerId is string && band.ownerId == request.auth.uid)
          || (band.memberRoles is map && band.memberRoles[request.auth.uid] == 'editor')
        );
    }

    // Recordings are browser-recorded audio (MediaRecorder, audio/webm or audio/ogg);
    // there's no fixed per-file cap client-side (only an aggregate plan storage quota),
    // so this is a generous sanity ceiling against abuse, not a plan limit.
    function isValidRecordingUpload() {
      return request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType.matches('^audio/.*');
    }

    // User-scoped song recordings
    match /users/{userId}/songs/{songId}/recordings/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.auth.token.email_verified == true
        && isValidRecordingUpload();
    }

    // Band-scoped song recordings
    match /bands/{bandId}/songs/{songId}/recordings/{fileName} {
      allow read: if isBandMember(bandId);
      allow write: if isBandMember(bandId) && isValidRecordingUpload();
    }

    // Server-side mirror of ATTACHMENT_MAX_SIZE_BYTES / ATTACHMENT_ACCEPTED_MIME_TYPE
    // in src/lib/songAttachments.ts. Client-side checks alone can be bypassed by
    // calling the Storage SDK/REST API directly, so enforce them here too.
    function isValidAttachmentUpload() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // User-scoped song attachments (PDFs)
    match /users/{userId}/songs/{songId}/attachments/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.auth.token.email_verified == true
        && isValidAttachmentUpload();
    }

    // Band-scoped song attachments (PDFs)
    match /bands/{bandId}/songs/{songId}/attachments/{fileName} {
      allow read: if isBandMember(bandId);
      allow write: if isBandMember(bandId) && isValidAttachmentUpload();
    }

    // Band-scoped press kit image assets
    match /bands/{bandId}/presskit/images/{fileName} {
      allow read: if isBandMember(bandId);
      allow write: if isBandEditor(bandId);
    }

    // Band logo asset at the band root (bands/{bandId}/logo.ext)
    match /bands/{bandId}/{fileName} {
      allow read: if isBandMember(bandId)
        && fileName.matches('^logo\\.[^/]+$');
      allow write: if isBandEditor(bandId)
        && fileName.matches('^logo\\.[^/]+$');
    }

    // Deny all other storage access by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
