# Optional: production error monitoring (https://sentry.io). Leave unset to disable.
VITE_SENTRY_DSN=

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=songbook-bebd5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=songbook-bebd5
VITE_FIREBASE_STORAGE_BUCKET=songbook-bebd5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Stripe price IDs (client-side, safe to expose — these are not secret keys)
# Obtain from Stripe Dashboard > Products > your plan > Pricing > Price ID (price_xxx)
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
VITE_STRIPE_CREW_MONTHLY_PRICE_ID=price_xxx
VITE_STRIPE_CREW_ANNUAL_PRICE_ID=price_xxx

# Firebase Admin SDK credentials (server-side only, never commit)
# Obtain these from Google Cloud Console > Service Accounts > Create Key (JSON format)
# Then extract the individual fields:
FIREBASE_PROJECT_ID=songbook-bebd5
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account-email

# Stripe secret key (server-side only, set via Cloudflare dashboard secrets — never commit)
# Use test key (sk_test_xxx) for dev, live key (sk_live_xxx) for production
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret — from Stripe Dashboard > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Same price IDs as above, mirrored here for the Cloudflare Functions side
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
STRIPE_CREW_MONTHLY_PRICE_ID=price_xxx
STRIPE_CREW_ANNUAL_PRICE_ID=price_xxx
# Comma-separated Firebase UIDs allowed to call /api/stripe/override-plan
ADMIN_UIDS=uid1,uid2
