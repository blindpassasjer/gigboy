# Self-host configuration for Gigboy (Docker Compose deployment).
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# UID/GID the postgres container runs as, and the owner the ./data/postgres bind mount needs on
# the host. Defaults to 999 (the postgres image's built-in "postgres" user) — only change these
# if you want Postgres to run as a specific host user (e.g. your own UID, so you can read/manage
# ./data/postgres without sudo). Whatever you set here, chown ./data/postgres to match BEFORE the
# first `docker compose up`, e.g.: mkdir -p data/postgres && chown -R 999:999 data/postgres
PUID=999
PGID=999

# Postgres password used by both the `postgres` service and DATABASE_URL below — keep them in sync.
POSTGRES_PASSWORD=change-me

# Connection string the app server uses to reach Postgres. Required, no fallback — the app
# fails fast at startup if this is unset. When running via docker-compose, "postgres" is the
# service hostname; the password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://gigboy:change-me@postgres:5432/gigboy

# Secret used to sign session cookies. Required, no fallback. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Port the app server listens on inside the container.
PORT=6168

# Whether session cookies get the `Secure` flag (only sent over HTTPS). Leave unset/false if
# you're accessing Gigboy directly over http:// (e.g. http://<nas-ip>:6168) — a Secure cookie
# would be silently dropped by the browser and login would appear to work but every API call
# would 401. Set to "true" only once a reverse proxy in front of the container terminates HTTPS.
COOKIE_SECURE=false

# Optional but recommended once a reverse proxy / public domain is in front of the container:
# the canonical public origin (scheme + host, no trailing slash) used to build invite links,
# press-kit share URLs and Open Graph tags. When unset these are derived from the request's
# Host header, which a client can forge (link/cache poisoning). Example:
#   PUBLIC_ORIGIN=https://gigboy.example.com
PUBLIC_ORIGIN=

# How many reverse-proxy hops to trust for the client IP (used by the auth rate limiter).
# Default "false" (correct when the container is exposed directly). Set to "1" for a single
# proxy in front, or a subnet/list per Express's "trust proxy" docs. Don't set "1" without an
# actual proxy — X-Forwarded-For would then be client-spoofable.
TRUST_PROXY=false

# Optional: operator details shown on the built-in Terms of Service and Privacy Policy
# pages (/terms and /privacy). Leave any of them unset to fall back to generic wording
# ("the operator of this Gigboy instance"). OPERATOR_JURISDICTION is the place whose laws
# govern the Terms (e.g. "Norway", "California, USA").
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_JURISDICTION=

# Optional: set BOTH of these to bootstrap an initial admin account on first run (the
# migrations + bootstrap step runs once before the server starts). Leave both unset if an
# admin account already exists in the database from a previous run, or if you'll create the
# first admin another way. Setting only one of the two is a startup error.
ADMIN_EMAIL=
ADMIN_PASSWORD=
